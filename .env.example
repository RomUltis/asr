# ===========================================================================
#  Orbit — configuration
#  Copiez ce fichier en ".env" et adaptez les valeurs.
# ===========================================================================

# Port d'ecoute du serveur Node (le reverse proxy redirige vers ce port)
PORT=56200

# Adresse d'ecoute. 127.0.0.1 = accessible uniquement via le reverse proxy (recommande)
HOST=127.0.0.1

# Secret de signature des sessions (OBLIGATOIRE en production : longue chaine aleatoire)
#   Generer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=changez-moi-avec-une-longue-chaine-aleatoire

# Cookies "Secure" : true uniquement si le site est servi en HTTPS
SECURE_COOKIES=false

# Duree d'une session (jours)
SESSION_TTL_DAYS=14

# --- Base de donnees ---
# "sqlite" : local, zero configuration (fichier data/orbit.db, Node >= 22.5)
# "mysql"  : VPS avec MySQL/MariaDB + phpMyAdmin
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=orbit_user
DB_PASSWORD=
DB_NAME=orbit
